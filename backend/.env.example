# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_HTTP_CONNECT_TIMEOUT_SECONDS=5
SUPABASE_HTTP_READ_TIMEOUT_SECONDS=15
SUPABASE_HTTP_WRITE_TIMEOUT_SECONDS=15
SUPABASE_HTTP_POOL_TIMEOUT_SECONDS=5

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) — migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Azure AI Foundry (OpenAI-compatible v1 API) ---

AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your-foundry-resource-key
AZURE_OPENAI_ASSISTANT_DEPLOYMENT=assistant-gpt-5-6-terra
AZURE_OPENAI_KEYWORD_DEPLOYMENT=keywords-gpt-5-4-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embeddings-text-embedding-3-small
AZURE_OPENAI_HTTP_MAX_RETRIES=3

# Underlying model identities remain separate from Azure deployment aliases.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_KEYWORD_MODEL=gpt-5.4-nano
OPENAI_KEYWORD_MAX_OUTPUT_TOKENS=800
OPENAI_ASSISTANT_MODEL=gpt-5.6-terra
OPENAI_ASSISTANT_REASONING_EFFORT=medium
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=3000

# One turn stays below the assistant deployment's 100,000 TPM allocation.
ASSISTANT_MAX_MODEL_REQUESTS=10
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_TOTAL_INPUT_TOKENS=60000
ASSISTANT_MAX_TOTAL_OUTPUT_TOKENS=6000
ASSISTANT_MAX_REQUEST_INPUT_TOKENS=32000
ASSISTANT_MAX_SEARCH_CALLS=5
ASSISTANT_MAX_SURROUNDING_CALLS=2
ASSISTANT_SEARCH_RESULT_LIMIT=10
ASSISTANT_EVIDENCE_PREVIEW_CHARACTERS=400

# Hard deadline for one complete retrieval, agent, validation, and persistence turn.
CHAT_TURN_TIMEOUT_SECONDS=180

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Local development: readable, content-rich assistant traces.
# Railway should use LOG_FORMAT=json and ASSISTANT_TRACE_MODE=summary.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
ASSISTANT_TRACE_MODE=full
ASSISTANT_TRACE_MAX_CONTENT_CHARACTERS=12000
LOG_MAX_EVENT_BYTES=4096
