:{$PORT:8080} {
	# Keep the health response independent from the SPA fallback.
	handle /health {
		respond "ok" 200
	}

	handle {
		encode zstd gzip
		root * /srv

		# Vite fingerprints production assets, so they are safe to cache indefinitely.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Serve index.html for client-side routes and always revalidate the app shell.
		route {
			try_files {path} /index.html
			header /index.html Cache-Control "public, max-age=0, must-revalidate"
		}

		file_server
	}
}
